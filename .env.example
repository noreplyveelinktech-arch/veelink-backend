# Server
PORT=8080

# PostgreSQL
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/veelink_cms
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# JWT
JWT_SECRET=changeThisSecretKeyToSomethingLongAndRandomForProductionUse
JWT_EXPIRATION_MS=86400000

# SMTP / Email
# Gmail example: create an "App Password" for noreply.veelinktech@gmail.com and use it below.
# Do NOT commit the real password - set it via environment variables / hosting secrets only.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=noreply.veelinktech@gmail.com
MAIL_PASSWORD=
MAIL_FROM=noreply.veelinktech@gmail.com
MAIL_FROM_NAME=Veelink Technologies

# Frontend origin for CORS
FRONTEND_URL=http://localhost:5173