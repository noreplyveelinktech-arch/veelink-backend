# Server
PORT=8080

# PostgreSQL
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/veelink_cms
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# JWT
JWT_SECRET=changeThisSecretKeyToSomethingLongAndRandomForProductionUse
JWT_EXPIRATION_MS=86400000

# Brevo (Sendinblue) transactional email API
# Sign up free at https://www.brevo.com, then go to Settings > SMTP & API > API Keys > Generate a new API key.
# Also verify a sender identity/domain in Brevo matching MAIL_FROM below, otherwise sends will be rejected.
BREVO_API_KEY=
MAIL_FROM=noreply.veelinktech@gmail.com
MAIL_FROM_NAME=Veelink Technologies

# Cloudinary (image uploads for logo, course images, team photos, etc.)
# Sign up free at https://cloudinary.com -> Dashboard shows Cloud Name, API Key, API Secret.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Frontend origin(s) for CORS - comma-separated if you have more than one (e.g. staging + production)
FRONTEND_URL=http://localhost:5173